# ====================
# 教育版掌柜智库 环境变量模板(复制为 .env 后填写)
# 技术栈与模板 atguigu-shopkeeper 一致,仅业务内容域改为教育场景
# ====================

# ====================
# Model Source & Cache
# ====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=<你的ModelScope缓存目录>
HF_HOME=<你的HuggingFace缓存目录>
MD_ROOT_DIR=./temp-files/

# Mineru PDF 解析服务(本地启动: mineru-api --host 127.0.0.1 --port 8000)
MINERU_API_TOKEN=<你的Mineru Token>
MINERU_BASE_URL=http://127.0.0.1:8000

# ====================
# 主 LLM(DeepSeek: 对话 / 推理 / 工具调用)
# ====================
DEEPSEEK_API_KEY=<你的DeepSeek API Key>
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ====================
# 视觉 LLM(DashScope: 图片识别 / vision_analyze)
# ====================
DASHSCOPE_API_KEY=<你的百炼 DashScope API Key>
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=<视觉语言模型名>
ITEM_MODEL=deepseek-v4-flash

# ====================
# BGE Embedding Models
# ====================
BGE_M3_PATH=<BGE-M3 本地模型目录>
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_LARGE=<bge-reranker-large 本地模型目录>
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=1

# ====================
# Vector Database (Milvus) —— 教育版建议使用独立集合名,避免与模板数据冲突
# ====================
MILVUS_URL=http://<milvus-host>:19530
CHUNKS_COLLECTION=edu_chunks_v1
ITEM_NAME_COLLECTION=edu_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75
# MILVUS_USER=root
# MILVUS_PASSWORD=<password>

# ====================
# Document Database (MongoDB) —— 教育版建议使用独立库名
# ====================
MONGO_URL=mongodb://<user>:<password>@<mongo-host>:27017/?authSource=admin
MONGO_DB_NAME=kb_edu

# ====================
# Object Storage (MinIO) —— 教育版建议使用独立桶名
# ====================
MINIO_ENDPOINT=<minio-host>:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edu-knowledge-files

# ====================
# Other / MCP Services
# ====================
# MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
